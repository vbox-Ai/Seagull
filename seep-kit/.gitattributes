# -----------------------------------------------------------------------------
# Seep Reverse Lab — Git 跨平台换行符与编码自动化管理规约
# -----------------------------------------------------------------------------

# 默认全局：自动探测文本文件，统一以 LF 换行归档
* text=auto eol=lf

# Linux / macOS 核心执行脚本：绝对强制严格 LF（绝不允许混入 \r，防 ^M bad interpreter）
*.sh text eol=lf
*.bash text eol=lf

# Windows 原生脚本：保持 CRLF 换行
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 编程语言源代码与配置：统一强制严格 LF
*.py text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf

# 二进制文件：严格保持二进制原样，禁用任何换行符转换
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.jar binary
*.zip binary
*.7z binary
*.png binary
*.ico binary
*.pdf binary
